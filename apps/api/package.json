{
  "name": "@pegah/api",
  "version": "0.1.0",
  "private": true,
  "description": "Pegah REST API — NestJS on Fastify. All business rules live here.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "openapi": "node scripts/export-openapi.mjs",
    "seed:rbac": "node dist/cli/seed-rbac.js",
    "seed:sample": "node dist/cli/seed-sample.js",
    "staff:create": "node dist/cli/create-staff.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@pegah/contracts": "*",
    "@pegah/db": "*",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "nestjs-zod": "5.5.0",
    "nodemailer": "10.1.7",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/nodemailer": "8.0.2"
  }
}
