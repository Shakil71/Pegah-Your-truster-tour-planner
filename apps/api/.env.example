# Copy to apps/api/.env for local development. Never commit the real file.
# On servers, values live in /opt/pegah/shared/env/api.env (mode 0600).

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# mysql://USER:PASSWORD@HOST:3306/DATABASE — use a least-privilege app user.
DATABASE_URL=

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Browser origins allowed to call the API with credentials (comma-separated).
APP_ORIGINS=http://localhost:3000,http://localhost:3001

# true behind HTTPS (production). Enables Secure cookies with the __Host- prefix.
COOKIE_SECURE=false

# Set to the number of trusted reverse proxies in front of the API (Nginx = 1).
TRUST_PROXY_HOPS=0

# Serve the OpenAPI JSON at /api/docs/openapi.json (keep false in production).
OPENAPI_ENABLED=true

# ── Payments (ADR-0022). Off unless set. See docs/operations/SSLCOMMERZ_INTEGRATION.md.
# PAYMENT_PROVIDER=none            # none | sslcommerz | simulator (simulator: never in production)
# PUBLIC_BASE_URL=http://localhost:3000   # customer-facing origin used for payment return URLs
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_MODE=sandbox          # live also needs SSLCOMMERZ_LIVE_APPROVED=true
# SSLCOMMERZ_PRODUCT_PROFILE=non-physical-goods
# PAYMENT_HOLD_EXTENSION_MINUTES=20

# ── Email (ADR-0024). none = record only (default), log = print recipient/subject, smtp = send.
# EMAIL_TRANSPORT=none
# EMAIL_FROM=Pegah <no-reply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false          # false = STARTTLS required on 587; true = implicit TLS on 465
# SMTP_USER=
# SMTP_PASSWORD=
# OUTBOX_POLL_SECONDS=10
