# Copy to apps/api/.env for local development. Never commit the real file.
# On servers, values live in /opt/pegah/shared/env/api.env (mode 0600).

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# mysql://USER:PASSWORD@HOST:3306/DATABASE — use a least-privilege app user.
DATABASE_URL=

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Browser origins allowed to call the API with credentials (comma-separated).
APP_ORIGINS=http://localhost:3000,http://localhost:3001

# true behind HTTPS (production). Enables Secure cookies with the __Host- prefix.
COOKIE_SECURE=false

# Set to the number of trusted reverse proxies in front of the API (Nginx = 1).
TRUST_PROXY_HOPS=0

# Serve the OpenAPI JSON at /api/docs/openapi.json (keep false in production).
OPENAPI_ENABLED=true
