[Unit]
Description=Pegah nightly MySQL backup
After=mysqld.service

[Service]
Type=oneshot
User=pegah
Group=pegah
ExecStart=/opt/pegah/bin/mysql-backup.sh
ReadWritePaths=/databackup/mysql-backups
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
