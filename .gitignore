# recorded. Keep them outside the repository (docs/operations/LEGACY_IMPORT.md).
/images/
/legacy-*/

# Logs
*.log
logs/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code local settings
.claude/settings.local.json

# Generated by Next.js (next typegen / next build)
next-env.d.ts

# Generated Prisma client
packages/db/src/generated/

# End-to-end run state (contains a generated test password)
e2e/.state/
