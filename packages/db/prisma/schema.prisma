// Pegah database schema — MySQL 8.4 LTS, InnoDB, utf8mb4.
// Conventions (docs/database/DATABASE_DESIGN.md):
//   * internal BIGINT UNSIGNED ids; public CHAR(26) ULIDs where exposed
//   * money = BIGINT minor units + CHAR(3) currency (ADR-0004)
//   * timestamps DATETIME(3) in UTC; calendar dates DATE (Asia/Dhaka calendar)
//   * CHECK constraints Prisma cannot express are added in migration SQL
// Production applies migrations with `prisma migrate deploy` only.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "mysql"
}

// ─── Identity ────────────────────────────────────────────────────────────────

enum UserKind {
  CUSTOMER
  STAFF
  /// Works for a supplier or travel agent (Phase 7).
  PARTNER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  publicId     String     @unique @map("public_id") @db.Char(26)
  email        String     @unique @db.VarChar(254)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(120)
  phone        String?    @db.VarChar(20)
  kind         UserKind   @default(CUSTOMER)
  /// Set only for PARTNER users: the company they act for.
  partnerId    BigInt?    @map("partner_id") @db.UnsignedBigInt
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.DateTime(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  roles        UserRole[]           @relation("UserRoles")
  rolesGranted UserRole[]           @relation("RoleGrants")
  sessions     Session[]
  bookings     Booking[]
  travellers   TravellerProfile[]
  resetTokens  PasswordResetToken[]
  partner      Partner?             @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([partnerId])
  @@map("users")
}

model Role {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  key         String   @unique @db.VarChar(40)
  name        String   @db.VarChar(80)
  description String   @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  key         String   @unique @db.VarChar(60)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt   @map("role_id") @db.UnsignedBigInt
  permissionId BigInt   @map("permission_id") @db.UnsignedBigInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      BigInt   @map("user_id") @db.UnsignedBigInt
  roleId      BigInt   @map("role_id") @db.UnsignedBigInt
  grantedById BigInt?  @map("granted_by_id") @db.UnsignedBigInt
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("RoleGrants", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([grantedById])
  @@map("user_roles")
}

enum SessionKind {
  CUSTOMER
  STAFF
  PARTNER
}

/// Server-side session. The cookie carries a random token; only its SHA-256
/// hash is stored, so a database leak does not leak live sessions.
model Session {
  id         BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  tokenHash  String      @unique @map("token_hash") @db.Char(64)
  userId     BigInt      @map("user_id") @db.UnsignedBigInt
  kind       SessionKind
  ipAddress  String?     @map("ip_address") @db.VarChar(45)
  userAgent  String?     @map("user_agent") @db.VarChar(255)
  lastSeenAt DateTime    @map("last_seen_at") @db.DateTime(3)
  expiresAt  DateTime    @map("expires_at") @db.DateTime(3)
  revokedAt  DateTime?   @map("revoked_at") @db.DateTime(3)
  createdAt  DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

/// Photography must be owned, commissioned or licensed; credit is required
/// for anything shown publicly (docs/design/IMAGE_CREDITS.md).
model MediaAsset {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  storageKey String   @unique @map("storage_key") @db.VarChar(255)
  altText    String   @map("alt_text") @db.VarChar(255)
  credit     String?  @db.VarChar(255)
  license    String?  @db.VarChar(80)
  width      Int?     @db.UnsignedSmallInt
  height     Int?     @db.UnsignedSmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  destinations Destination[]
  hotels       Hotel[]
  tours        Tour[]

  @@map("media_assets")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

model Destination {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  slug        String        @unique @db.VarChar(80)
  name        String        @db.VarChar(120)
  nameBn      String?       @map("name_bn") @db.VarChar(120)
  region      String        @db.VarChar(80)
  summary     String        @db.VarChar(500)
  heroMediaId BigInt?       @map("hero_media_id") @db.UnsignedBigInt
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  hero   MediaAsset? @relation(fields: [heroMediaId], references: [id], onDelete: SetNull)
  hotels Hotel[]
  tours  Tour[]

  @@index([status, sortOrder])
  @@index([heroMediaId])
  @@map("destinations")
}

model Hotel {
  id                 BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId           String        @unique @map("public_id") @db.Char(26)
  slug               String        @unique @db.VarChar(80)
  destinationId      BigInt        @map("destination_id") @db.UnsignedBigInt
  name               String        @db.VarChar(160)
  nameBn             String?       @map("name_bn") @db.VarChar(160)
  starRating         Int?          @map("star_rating") @db.UnsignedTinyInt
  addressLine        String        @map("address_line") @db.VarChar(255)
  summary            String        @db.VarChar(500)
  description        String?       @db.Text
  checkInTime        String        @default("14:00") @map("check_in_time") @db.Char(5)
  checkOutTime       String        @default("12:00") @map("check_out_time") @db.Char(5)
  cancellationPolicy String        @map("cancellation_policy") @db.VarChar(500)
  currency           String        @default("BDT") @db.Char(3)
  /// Service charge in basis points of the room base (1000 = 10%).
  serviceChargeBps   Int           @default(0) @map("service_charge_bps") @db.UnsignedSmallInt
  /// VAT in basis points, applied on base + service charge.
  vatBps             Int           @default(0) @map("vat_bps") @db.UnsignedSmallInt
  heroMediaId        BigInt?       @map("hero_media_id") @db.UnsignedBigInt
  status             PublishStatus @default(DRAFT)
  createdAt          DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  /// Supplier that manages this hotel in the partner portal (optional).
  partnerId   BigInt?     @map("partner_id") @db.UnsignedBigInt
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  hero        MediaAsset? @relation(fields: [heroMediaId], references: [id], onDelete: SetNull)
  rooms       HotelRoom[]
  partner     Partner?    @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([destinationId, status])
  @@index([heroMediaId])
  @@map("hotels")
}

model HotelRoom {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId    String   @unique @map("public_id") @db.Char(26)
  hotelId     BigInt   @map("hotel_id") @db.UnsignedBigInt
  name        String   @db.VarChar(120)
  description String   @db.VarChar(500)
  maxAdults   Int      @map("max_adults") @db.UnsignedTinyInt
  maxChildren Int      @default(0) @map("max_children") @db.UnsignedTinyInt
  bedType     String   @map("bed_type") @db.VarChar(60)
  sizeSqm     Int?     @map("size_sqm") @db.UnsignedSmallInt
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  hotel        Hotel           @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  inventory    RoomInventory[]
  rates        RoomRate[]
  bookingItems BookingItem[]
  holds        InventoryHold[]

  @@unique([hotelId, name])
  @@map("hotel_rooms")
}

// ─── Inventory and rates ─────────────────────────────────────────────────────

/// One row per room type per night. Holds lock the row with SELECT … FOR UPDATE;
/// CHECK (held + sold <= total) is enforced in migration SQL.
model RoomInventory {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  roomId    BigInt   @map("room_id") @db.UnsignedBigInt
  stayDate  DateTime @map("stay_date") @db.Date
  total     Int      @db.UnsignedSmallInt
  held      Int      @default(0) @db.UnsignedSmallInt
  sold      Int      @default(0) @db.UnsignedSmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  room HotelRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([roomId, stayDate])
  @@index([stayDate])
  @@map("room_inventory")
}

model RoomRate {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  roomId      BigInt   @map("room_id") @db.UnsignedBigInt
  stayDate    DateTime @map("stay_date") @db.Date
  amountMinor BigInt   @map("amount_minor")
  currency    String   @default("BDT") @db.Char(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  room HotelRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([roomId, stayDate])
  @@map("room_rates")
}

// ─── Tours ───────────────────────────────────────────────────────────────────

model Tour {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String        @unique @map("public_id") @db.Char(26)
  slug           String        @unique @db.VarChar(80)
  destinationId  BigInt        @map("destination_id") @db.UnsignedBigInt
  title          String        @db.VarChar(160)
  titleBn        String?       @map("title_bn") @db.VarChar(160)
  summary        String        @db.VarChar(500)
  description    String        @db.Text
  durationDays   Int           @map("duration_days") @db.UnsignedTinyInt
  durationNights Int           @map("duration_nights") @db.UnsignedTinyInt
  meetingPoint   String        @map("meeting_point") @db.VarChar(255)
  groupSizeMax   Int           @map("group_size_max") @db.UnsignedSmallInt
  /// JSON arrays of strings.
  highlights     Json
  includes       Json
  excludes       Json
  currency       String        @default("BDT") @db.Char(3)
  vatBps         Int           @default(0) @map("vat_bps") @db.UnsignedSmallInt
  heroMediaId    BigInt?       @map("hero_media_id") @db.UnsignedBigInt
  status         PublishStatus @default(DRAFT)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  partnerId   BigInt?        @map("partner_id") @db.UnsignedBigInt
  destination Destination    @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  hero        MediaAsset?    @relation(fields: [heroMediaId], references: [id], onDelete: SetNull)
  schedules   TourSchedule[]
  partner     Partner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([destinationId, status])
  @@index([heroMediaId])
  @@map("tours")
}

enum TourScheduleStatus {
  SCHEDULED
  CLOSED
  CANCELLED
}

/// A dated departure. CHECK (held + sold <= capacity) is enforced in migration SQL.
model TourSchedule {
  id              BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String             @unique @map("public_id") @db.Char(26)
  tourId          BigInt             @map("tour_id") @db.UnsignedBigInt
  departsAt       DateTime           @map("departs_at") @db.DateTime(3)
  returnsAt       DateTime           @map("returns_at") @db.DateTime(3)
  capacity        Int                @db.UnsignedSmallInt
  held            Int                @default(0) @db.UnsignedSmallInt
  sold            Int                @default(0) @db.UnsignedSmallInt
  priceAdultMinor BigInt             @map("price_adult_minor")
  priceChildMinor BigInt             @map("price_child_minor")
  currency        String             @default("BDT") @db.Char(3)
  status          TourScheduleStatus @default(SCHEDULED)
  createdAt       DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  tour         Tour            @relation(fields: [tourId], references: [id], onDelete: Restrict)
  bookingItems BookingItem[]
  holds        InventoryHold[]

  @@index([tourId, departsAt])
  @@map("tour_schedules")
}

// ─── Bookings ────────────────────────────────────────────────────────────────

enum BookingStatus {
  DRAFT
  PENDING_AVAILABILITY
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  CONFIRMED
  COMPLETED
  FAILED
  EXPIRED
  MANUAL_REVIEW
  CANCELLATION_REQUESTED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum ProductType {
  HOTEL
  TOUR
}

/// Status changes only through the API's booking state machine, which writes
/// booking_status_history in the same transaction.
model Booking {
  id                 BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId           String        @unique @map("public_id") @db.Char(26)
  reference          String        @unique @db.VarChar(12)
  userId             BigInt        @map("user_id") @db.UnsignedBigInt
  status             BookingStatus @default(DRAFT)
  productType        ProductType   @map("product_type")
  productName        String        @map("product_name") @db.VarChar(160)
  startDate          DateTime      @map("start_date") @db.Date
  endDate            DateTime?     @map("end_date") @db.Date
  guestCount         Int           @map("guest_count") @db.UnsignedSmallInt
  currency           String        @default("BDT") @db.Char(3)
  baseMinor          BigInt        @map("base_minor")
  serviceChargeMinor BigInt        @default(0) @map("service_charge_minor")
  vatMinor           BigInt        @default(0) @map("vat_minor")
  /// Promotion discount on the base, before service charge and VAT.
  discountMinor      BigInt        @default(0) @map("discount_minor")
  /// Travel agent that made this booking for a client, and the commission earned.
  agentPartnerId     BigInt?       @map("agent_partner_id") @db.UnsignedBigInt
  commissionMinor    BigInt        @default(0) @map("commission_minor")
  promotionId        BigInt?       @map("promotion_id") @db.UnsignedBigInt
  totalMinor         BigInt        @map("total_minor")
  contactName        String        @map("contact_name") @db.VarChar(120)
  contactEmail       String        @map("contact_email") @db.VarChar(254)
  contactPhone       String        @map("contact_phone") @db.VarChar(20)
  holdExpiresAt      DateTime?     @map("hold_expires_at") @db.DateTime(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  user      User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  items     BookingItem[]
  guests    BookingGuest[]
  holds     InventoryHold[]
  history   BookingStatusHistory[]
  payments  Payment[]
  refunds   Refund[]
  promotion Promotion?             @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  agent     Partner?               @relation("AgentBookings", fields: [agentPartnerId], references: [id], onDelete: Restrict)
  emails    EmailMessage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("bookings")
}

enum BookingItemType {
  HOTEL_ROOM
  TOUR_SEAT
}

model BookingItem {
  id             BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  bookingId      BigInt          @map("booking_id") @db.UnsignedBigInt
  itemType       BookingItemType @map("item_type")
  hotelRoomId    BigInt?         @map("hotel_room_id") @db.UnsignedBigInt
  tourScheduleId BigInt?         @map("tour_schedule_id") @db.UnsignedBigInt
  description    String          @db.VarChar(255)
  quantity       Int             @db.UnsignedSmallInt
  amountMinor    BigInt          @map("amount_minor")
  currency       String          @default("BDT") @db.Char(3)
  /// Price snapshot at booking time (nightly rates, tax basis points).
  priceSnapshot  Json            @map("price_snapshot")
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  booking      Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  hotelRoom    HotelRoom?      @relation(fields: [hotelRoomId], references: [id], onDelete: Restrict)
  tourSchedule TourSchedule?   @relation(fields: [tourScheduleId], references: [id], onDelete: Restrict)
  holds        InventoryHold[]

  @@index([bookingId])
  @@index([hotelRoomId])
  @@index([tourScheduleId])
  @@map("booking_items")
}

enum GuestAgeGroup {
  ADULT
  CHILD
}

model BookingGuest {
  id        BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  bookingId BigInt        @map("booking_id") @db.UnsignedBigInt
  fullName  String        @map("full_name") @db.VarChar(120)
  ageGroup  GuestAgeGroup @default(ADULT) @map("age_group")
  isLead    Boolean       @default(false) @map("is_lead")
  createdAt DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_guests")
}

enum HoldStatus {
  ACTIVE
  CONVERTED
  RELEASED
}

model InventoryHold {
  id             BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  bookingId      BigInt     @map("booking_id") @db.UnsignedBigInt
  bookingItemId  BigInt?    @map("booking_item_id") @db.UnsignedBigInt
  hotelRoomId    BigInt?    @map("hotel_room_id") @db.UnsignedBigInt
  tourScheduleId BigInt?    @map("tour_schedule_id") @db.UnsignedBigInt
  stayDate       DateTime?  @map("stay_date") @db.Date
  quantity       Int        @db.UnsignedSmallInt
  status         HoldStatus @default(ACTIVE)
  expiresAt      DateTime   @map("expires_at") @db.DateTime(3)
  releasedAt     DateTime?  @map("released_at") @db.DateTime(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bookingItem  BookingItem?  @relation(fields: [bookingItemId], references: [id], onDelete: Restrict)
  hotelRoom    HotelRoom?    @relation(fields: [hotelRoomId], references: [id], onDelete: Restrict)
  tourSchedule TourSchedule? @relation(fields: [tourScheduleId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([bookingId])
  @@index([bookingItemId])
  @@index([hotelRoomId, stayDate])
  @@index([tourScheduleId])
  @@map("inventory_holds")
}

enum ActorType {
  CUSTOMER
  STAFF
  SYSTEM
  PAYMENT_PROVIDER
  PARTNER
}

model BookingStatusHistory {
  id          BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  bookingId   BigInt         @map("booking_id") @db.UnsignedBigInt
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus  @map("to_status")
  actorType   ActorType      @map("actor_type")
  actorUserId BigInt?        @map("actor_user_id") @db.UnsignedBigInt
  reason      String?        @db.VarChar(500)
  createdAt   DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

// ─── Payments ────────────────────────────────────────────────────────────────

enum PaymentStatus {
  /// Row created; the provider session has not been opened yet.
  INITIATED
  /// Customer sent to the provider's hosted page; outcome unknown.
  PENDING
  /// Verified with the provider (server-to-server); amount and currency matched.
  SUCCEEDED
  FAILED
  CANCELLED
  /// Verified paid, but the booking could not be confirmed (hold expired,
  /// cancelled, amount mismatch): staff must refund or resolve it.
  REFUND_REQUIRED
}

/// One attempt to pay for a booking through a hosted payment page. No card
/// data is ever stored: only provider references and outcomes.
/// CHECK (amount_minor > 0) is enforced in migration SQL.
model Payment {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String        @unique @map("public_id") @db.Char(26)
  bookingId       BigInt        @map("booking_id") @db.UnsignedBigInt
  provider        String        @db.VarChar(30)
  /// Our transaction id sent to the provider (SSLCOMMERZ tran_id).
  providerTxnId   String        @map("provider_txn_id") @db.VarChar(64)
  providerSession String?       @map("provider_session") @db.VarChar(128)
  /// Provider validation id (SSLCOMMERZ val_id) once known.
  providerValId   String?       @map("provider_val_id") @db.VarChar(64)
  bankTxnId       String?       @map("bank_txn_id") @db.VarChar(80)
  amountMinor     BigInt        @map("amount_minor")
  currency        String        @default("BDT") @db.Char(3)
  status          PaymentStatus @default(INITIATED)
  failureReason   String?       @map("failure_reason") @db.VarChar(255)
  /// Provider risk flag (SSLCOMMERZ risk_level); non-zero sends the booking to review.
  riskLevel       Int?          @map("risk_level") @db.UnsignedTinyInt
  /// Card scheme or wallet name only (e.g. VISA, bKash), never card numbers.
  method          String?       @db.VarChar(60)
  succeededAt     DateTime?     @map("succeeded_at") @db.DateTime(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  events  PaymentEvent[]

  @@unique([provider, providerTxnId])
  @@index([bookingId])
  @@index([status, createdAt])
  @@map("payments")
}

/// Every callback received from a provider (IPN, browser return), stored
/// before processing and de-duplicated by (provider, event_key).
model PaymentEvent {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  paymentId   BigInt?   @map("payment_id") @db.UnsignedBigInt
  provider    String    @db.VarChar(30)
  /// Provider event identity, e.g. "ipn:<val_id>:<status>".
  eventKey    String    @map("event_key") @db.VarChar(160)
  kind        String    @db.VarChar(40)
  /// Whitelisted fields only (no card numbers, no secrets).
  payload     Json
  /// Signature check result (null when the provider sent no signature).
  signatureOk Boolean?  @map("signature_ok")
  processedAt DateTime? @map("processed_at") @db.DateTime(3)
  outcome     String?   @db.VarChar(80)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, eventKey])
  @@index([paymentId])
  @@map("payment_events")
}

// ─── Partners (Phase 7) ──────────────────────────────────────────────────────

enum PartnerKind {
  /// Hotel or tour operator managing its own inventory.
  SUPPLIER
  /// Travel agent booking for clients and earning commission.
  AGENT
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

/// A partner company. Its users (users.partner_id) sign in to the partner
/// portal and only ever see records owned by the partner.
model Partner {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId      String        @unique @map("public_id") @db.Char(26)
  kind          PartnerKind
  name          String        @db.VarChar(160)
  email         String        @db.VarChar(254)
  phone         String?       @db.VarChar(20)
  /// Agents only: commission on the booking total, basis points.
  commissionBps Int           @default(0) @map("commission_bps") @db.UnsignedSmallInt
  status        PartnerStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  members       User[]
  hotels        Hotel[]
  tours         Tour[]
  agentBookings Booking[] @relation("AgentBookings")

  @@index([kind, status])
  @@map("partners")
}

// ─── Promotions ──────────────────────────────────────────────────────────────

enum PromotionKind {
  /// Percentage of the base, in basis points.
  PERCENT
  /// Fixed amount off the base, in minor units.
  FIXED
}

enum PromotionScope {
  ALL
  HOTEL
  TOUR
}

enum PromotionStatus {
  ACTIVE
  PAUSED
}

/// Coupon codes. Redemptions are the bookings that reference the promotion
/// (expired, failed and unpaid-cancelled bookings do not count).
/// CHECK constraints in migration SQL keep values sane.
model Promotion {
  id               BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  publicId         String          @unique @map("public_id") @db.Char(26)
  /// Upper-case code customers type, e.g. MONSOON10.
  code             String          @unique @db.VarChar(40)
  name             String          @db.VarChar(120)
  kind             PromotionKind
  percentBps       Int?            @map("percent_bps") @db.UnsignedSmallInt
  amountMinor      BigInt?         @map("amount_minor")
  currency         String          @default("BDT") @db.Char(3)
  /// Minimum base (before taxes) for the code to apply.
  minSpendMinor    BigInt          @default(0) @map("min_spend_minor")
  /// Upper bound on the discount (useful for percentages).
  maxDiscountMinor BigInt?         @map("max_discount_minor")
  scope            PromotionScope  @default(ALL)
  startsAt         DateTime        @map("starts_at") @db.DateTime(3)
  endsAt           DateTime        @map("ends_at") @db.DateTime(3)
  maxRedemptions   Int?            @map("max_redemptions") @db.UnsignedInt
  perCustomerLimit Int             @default(1) @map("per_customer_limit") @db.UnsignedSmallInt
  status           PromotionStatus @default(ACTIVE)
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  bookings Booking[]

  @@index([status, startsAt, endsAt])
  @@map("promotions")
}

// ─── Content ─────────────────────────────────────────────────────────────────

/// Simple editable pages (About, Terms, Privacy…). Plain text with blank-line
/// paragraphs and "## " headings; rendered as text, never as raw HTML.
model ContentPage {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  slug        String        @unique @db.VarChar(80)
  title       String        @db.VarChar(160)
  summary     String        @db.VarChar(300)
  body        String        @db.Text
  status      PublishStatus @default(DRAFT)
  updatedById BigInt?       @map("updated_by_id") @db.UnsignedBigInt
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("content_pages")
}

// ─── Refunds ─────────────────────────────────────────────────────────────────

enum RefundStatus {
  /// Approved by staff; money not returned yet.
  PENDING
  /// Returned to the customer (provider reference recorded).
  PAID
}

/// Money owed back to a customer after an approved cancellation.
/// CHECK (amount_minor > 0) is enforced in migration SQL.
model Refund {
  id           BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId     String       @unique @map("public_id") @db.Char(26)
  bookingId    BigInt       @map("booking_id") @db.UnsignedBigInt
  amountMinor  BigInt       @map("amount_minor")
  currency     String       @default("BDT") @db.Char(3)
  status       RefundStatus @default(PENDING)
  reason       String       @db.VarChar(500)
  /// Provider or bank reference recorded when the refund is paid.
  providerRef  String?      @map("provider_ref") @db.VarChar(120)
  approvedById BigInt       @map("approved_by_id") @db.UnsignedBigInt
  paidById     BigInt?      @map("paid_by_id") @db.UnsignedBigInt
  paidAt       DateTime?    @map("paid_at") @db.DateTime(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([status, createdAt])
  @@map("refunds")
}

// ─── Customer profile ────────────────────────────────────────────────────────

/// Saved travellers a customer can pick at checkout. No identity documents.
model TravellerProfile {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId    String        @unique @map("public_id") @db.Char(26)
  userId      BigInt        @map("user_id") @db.UnsignedBigInt
  fullName    String        @map("full_name") @db.VarChar(120)
  ageGroup    GuestAgeGroup @default(ADULT) @map("age_group")
  dateOfBirth DateTime?     @map("date_of_birth") @db.Date
  nationality String?       @db.Char(2)
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("traveller_profiles")
}

/// Single-use password reset. Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Email ───────────────────────────────────────────────────────────────────

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  /// No email transport configured: recorded but not sent.
  SKIPPED
}

/// Every transactional email: what was sent to whom and the outcome.
/// Bodies are not stored (they may contain links that act as credentials).
model EmailMessage {
  id         BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  bookingId  BigInt?     @map("booking_id") @db.UnsignedBigInt
  toAddress  String      @map("to_address") @db.VarChar(254)
  template   String      @db.VarChar(60)
  subject    String      @db.VarChar(200)
  status     EmailStatus @default(QUEUED)
  providerId String?     @map("provider_id") @db.VarChar(200)
  error      String?     @db.VarChar(500)
  sentAt     DateTime?   @map("sent_at") @db.DateTime(3)
  createdAt  DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status, createdAt])
  @@map("email_messages")
}

// ─── Reliability ─────────────────────────────────────────────────────────────

model IdempotencyKey {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  actorKey       String    @map("actor_key") @db.VarChar(64)
  key            String    @db.VarChar(128)
  route          String    @db.VarChar(120)
  requestHash    String    @map("request_hash") @db.Char(64)
  responseStatus Int?      @map("response_status") @db.UnsignedSmallInt
  responseBody   Json?     @map("response_body")
  lockedUntil    DateTime? @map("locked_until") @db.DateTime(3)
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([actorKey, key, route])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model OutboxEvent {
  id            BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  eventType     String       @map("event_type") @db.VarChar(80)
  aggregateType String       @map("aggregate_type") @db.VarChar(40)
  aggregateId   String       @map("aggregate_id") @db.VarChar(40)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0) @db.UnsignedSmallInt
  availableAt   DateTime     @default(now()) @map("available_at") @db.DateTime(3)
  processedAt   DateTime?    @map("processed_at") @db.DateTime(3)
  lastError     String?      @map("last_error") @db.VarChar(1000)
  createdAt     DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([status, availableAt])
  @@map("outbox_events")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

/// Append-only. The application never updates or deletes audit rows.
model AuditEvent {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  actorType   ActorType @map("actor_type")
  actorUserId BigInt?   @map("actor_user_id") @db.UnsignedBigInt
  action      String    @db.VarChar(80)
  targetType  String?   @map("target_type") @db.VarChar(40)
  targetId    String?   @map("target_id") @db.VarChar(40)
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([targetType, targetId])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

/// Site settings edited in the console (ADR-0029). One JSON value per section
/// ("general", "announcement", "booking", "payments", "email"), validated by
/// @pegah/contracts schemas in the API. Never holds secrets.
model SiteSetting {
  key       String   @id @db.VarChar(60)
  value     Json
  updatedBy BigInt?  @map("updated_by") @db.UnsignedBigInt
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("site_settings")
}

/// Write-only credentials entered in the console, encrypted with AES-256-GCM
/// under SETTINGS_ENCRYPTION_KEY (server only). `keyId` identifies the key a
/// value was sealed with, so a rotated or missing key is detected, not misread.
model SecretSetting {
  key        String   @id @db.VarChar(60)
  ciphertext String   @db.Text
  keyId      String   @map("key_id") @db.VarChar(16)
  updatedBy  BigInt?  @map("updated_by") @db.UnsignedBigInt
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("secret_settings")
}
