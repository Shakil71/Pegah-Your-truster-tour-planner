{
  "name": "pegah",
  "version": "0.1.0",
  "private": true,
  "description": "Pegah Travel Platform monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev -w @pegah/web",
    "dev:admin": "npm run dev -w @pegah/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@swc/core": "1.16.18",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.18",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "fastify": "5.12.7",
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    }
  }
}
